<dialog
  data-modal-target="dialog"
  data-action="click->modal#backdropClose"
  aria-labelledby="<%= dom_id(room, :support_title) %>"
  aria-describedby="<%= dom_id(room, :support_description) %>"
  class="m-auto w-full max-w-lg border-0 bg-transparent p-0 backdrop:bg-black/50">
  <div class="max-h-[calc(100vh-2rem)] overflow-y-auto rounded bg-white p-8 shadow">
    <h1 id="<%= dom_id(room, :support_title) %>" class="text-xl mb-4">Support Info</h1>
    <ul id="<%= dom_id(room, :support_description) %>">
      <% unless room.room_support_phone == "Not Available" %>
        <li class="flex">
          <div class="icon self-center">
            <%= svg("phone") %>
          </div>
          <div class="pl-2 self-center">
            <%= room.room_support_phone %>
          </div>
        </li>
      <% end %>
      <% unless room.room_support_email == "Not Available" %>
        <li class="flex">
          <div class="icon self-center">
            <%= svg("envelope") %>
          </div>
          <div class="pl-2 self-center">
            <%= room.room_support_email %>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="flex justify-end items-center flex-wrap mt-6">
      <button type="button" aria-label="close" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" data-action="click->modal#close">
        Close
      </button>
    </div>
  </div>
</dialog>
